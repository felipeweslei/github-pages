  <title>Loja Fácil</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f9f9f9; }
    header { position: relative; text-align: center; }
    header img.banner { width: 100%; height: auto; }
    header h1 { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-size: 2em; text-shadow: 0 2px 5px rgba(0,0,0,0.5); }
    .container { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; padding: 20px; }
    .product { background-color: white; border: 1px solid #ddd; border-radius: 8px; padding: 15px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .product img { width: 100%; height: auto; border-radius: 4px; }
    .product h3 { margin: 10px 0; }
    .product p { color: #555; }
    .product button { background-color: #4CAF50; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; margin-top: 10px; }
    .product button:hover { background-color: #45a049; }
    #contact { background: #fff; padding: 20px; margin: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    #contact h2 { margin-top: 0; }
    #contact input, #contact textarea, #contact button { width: 100%; padding: 10px; margin: 5px 0; border: 1px solid #ccc; border-radius: 4px; }
    #contact button { background-color: #4CAF50; color: white; border: none; cursor: pointer; }
    #contact button:hover { background-color: #45a049; }
  </style>
</head>
